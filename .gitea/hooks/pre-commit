#!/bin/sh
# Pre-commit hook — run the test suite before every commit.
# Blocks the commit on failure.

echo "Running test suite..."

php -d zend.assertions=1 tests/run.php
status=$?

if [ $status -ne 0 ]; then
    echo
    echo "Test suite failed. Commit blocked."
    echo "Fix the failures above and try again."
    exit 1
fi

exit 0
