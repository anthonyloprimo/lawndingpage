# Module pane-content directories are runtime state — created and
# rewritten by the web server (per-pane settings sidecars, gallery
# uploads, etc.). Never tracked. Files committed here would land on
# deploy with the wrong owner and break web-side writes (EACCES).
public/res/data/*Content-*/
# Per-plugin runtime state (caches, scratch dirs). Plugins should write
# their runtime state under avatars/ or cache/ so it is ignored by default.
# .htaccess files that guard those dirs stay tracked.
public/plugins/*/avatars/*
!public/plugins/*/avatars/.htaccess
public/plugins/*/cache/*
!public/plugins/*/cache/.htaccess
