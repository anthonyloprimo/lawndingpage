# Live fixtures are auto-refreshed by the corresponding *-live.php test files.
# Hand-crafted curated fixtures (e.g. event-scraper-<source>-sample.html)
# stay tracked.
tests/fixtures/event-scraper-*-live.html
tests/fixtures/event-scraper-*-live.json

# Runtime public data lives under instance data/public/res/data in split layouts.
# Keep legacy public runtime state untracked if present during migration.
public/res/data/*Content-*/
public/res/data/*.json
public/res/data/*.md
!public/res/data/.htaccess

# Per-plugin runtime state (caches, scratch dirs). Plugins should write
# their runtime state under avatars/ or cache/ so it is ignored by default.
# .htaccess files that guard those dirs stay tracked.
admin/plugins/*/avatars/*
!admin/plugins/*/avatars/.htaccess
admin/plugins/*/cache/*
!admin/plugins/*/cache/.htaccess

# Analyzer + docs-generator PHARs are downloaded on demand by their
# respective installer scripts, never tracked. Pinned version + SHA
# live inside each installer.
tools/phpstan.phar
tools/phpDocumentor.phar

# phpDocumentor output + cache. Generated by .github/workflows/build-docs.yml
# on push to main and published to GitHub Pages; never committed.
build/
