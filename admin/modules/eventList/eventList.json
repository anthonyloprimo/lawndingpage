{
  "id": "eventList",
  "name": "Event List",
  "version": "1.2.0",
  "description": "Create and display events with calendar export.",
  "preview": "eventList.png",
  "default_icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M19,19V8H5V19H19M16,1H18V3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3H6V1H8V3H16V1M7,10H9V12H7V10M15,10H17V12H15V10M11,14H13V16H11V14M15,14H17V16H15V14Z\"/></svg>",
  "data_files": [
    { "type": "json", "pattern": "{paneId}.json", "initial": { "events": [] } }
  ],
  "save_map": [
    { "key": "events", "type": "json", "file": "{paneId}.json", "validator": "event_list_apply_events" }
  ],
  "per_pane_settings": [
    { "key": "showCalendar",    "label": "Show calendar view",                "type": "bool" },
    { "key": "calendarDefault", "label": "Open in calendar view by default",  "type": "bool" },
    { "key": "showPast",        "label": "Show past events on the public site", "type": "bool" }
  ],
  "settings_file": "eventListContent-{paneId}/settings.json",
  "pane_content_dir": "eventListContent-{paneId}",
  "site_config": {
    "label": "Event List",
    "settings": [
      { "key": "showCalendar",    "label": "Show calendar view",                  "type": "bool", "default": false },
      { "key": "calendarDefault", "label": "Open in calendar view by default",    "type": "bool", "default": true  },
      { "key": "showPast",        "label": "Show past events on the public site", "type": "bool", "default": false }
    ],
    "render": "event_list_render_site_config"
  }
}
