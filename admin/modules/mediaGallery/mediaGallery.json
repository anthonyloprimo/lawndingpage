{
  "id": "mediaGallery",
  "name": "Media Gallery Pane",
  "version": "1.0.0",
  "description": "Image and video gallery with lightbox viewing.",
  "preview": "mediaGallery.svg",
  "default_icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M22,16V4A2,2 0 0,0 20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16M11,12L13.03,14.71L16,11L20,16H8M2,6V20A2,2 0 0,0 4,22H18V20H4V6\"/></svg>",
  "data_files": [
    { "type": "json", "pattern": "mediaGalleryContent-{paneId}/items.json" }
  ],
  "save_map": [
    { "key": "mediaChanges", "type": "json", "file": "mediaGalleryContent-{paneId}/items.json" }
  ],
  "per_pane_settings": [
    { "key": "customThumbs", "label": "Allow per-item custom thumbnail uploads", "type": "bool" },
    { "key": "changeMedia",  "label": "Allow replacing media files on existing items", "type": "bool" }
  ],
  "settings_file": "mediaGalleryContent-{paneId}/settings.json"
}
