<?xml version="1.0" encoding="UTF-8" ?>
<!--
    phpDocumentor configuration for LawndingPage / LPCore.

    Generates HTML API docs from the PHPDoc shape types added across
    Phases 0-3 of the analyzer rollout. Output lives in build/docs/
    (gitignored). The .github/workflows/build-docs.yml workflow runs
    this on every push to main and publishes to GitHub Pages.

    Bumping the pin: see tools/install-phpdocumentor.sh's header.
-->
<phpdocumentor configVersion="3"
               xmlns="https://www.phpdoc.org">

    <title>LawndingPage API</title>

    <paths>
        <output>build/docs</output>
        <cache>build/phpdoc-cache</cache>
    </paths>

    <!--
        "clean" is the misleadingly-named Bootstrap-styled template;
        "default" is the plain minimal one. The bundled
        "responsive-twig" produces zero HTML in 3.9.1 (known broken),
        so the realistic richer choice is "clean".
    -->
    <template name="clean"/>

    <version number="latest">
        <api>
            <source dsn=".">
                <path>admin</path>
                <path>lp-bootstrap.php</path>
                <path>public</path>
            </source>
            <ignore hidden="true" symlinks="true">
                <path>tests/**/*</path>
                <path>public/res/scr/Parsedown.php</path>
                <path>public/res/scr/jquery-3.7.1.min.js</path>
                <path>tools/**/*</path>
                <path>build/**/*</path>
            </ignore>
            <extensions>
                <extension>php</extension>
            </extensions>
        </api>
    </version>

</phpdocumentor>
