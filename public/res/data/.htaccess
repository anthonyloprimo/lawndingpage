Options -Indexes
RewriteEngine On

# Block all direct file requests anywhere under /res/data (including subdirectories
# such as mediaGalleryContent-<paneId>/ where uploaded media lands).
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [F,L]

# Block dotfiles anywhere under /res/data.
RewriteRule (^|/)\. - [F,L]
