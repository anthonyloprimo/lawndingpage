<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve instance-owned site data from the sibling ../data tree.
    RewriteRule ^res/data/(.+)$ ../data/public/res/data/$1 [L]
    RewriteRule ^res/img/(.+)$ ../data/public/res/img/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

